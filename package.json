{
  "name": "fe",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios:run": "npx react-native run-ios --device",
    "ios:simulator": "npx react-native run-ios --simulator \"iPhone 15\"",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "ios:pods": "cd ios && pod install && cd ..",
    "ios:clean": "cd ios && rm -rf Pods build && pod install && cd ..",
    "js:clean": "rm -rf node_modules && npm install --legacy-peer-deps",
    "native:clean": "rm -rf ios/Pods ios/build ~/Library/Developer/Xcode/DerivedData/*",
    "reset": "rm -rf node_modules ios/Pods ios/build ~/Library/Developer/Xcode/DerivedData/* && npm install --legacy-peer-deps && cd ios && pod install && cd .."
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@portabletext/react-native": "^2.6.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@sanity/image-url": "^1.2.0",
    "@sentry/react-native": "^6.22.0",
    "axios": "^1.13.2",
    "lucide-react-native": "^0.543.0",
    "nativewind": "^2.0.11",
    "react": "19.0.0",
    "react-hook-form": "^7.63.0",
    "react-native": "0.79.6",
    "react-native-bootsplash": "^6.3.11",
    "react-native-dotenv": "^3.4.11",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-reanimated": "^3.10.1",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "4.15.0",
    "react-native-svg": "^15.13.0",
    "react-native-toast-message": "^2.3.3",
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.6",
    "@react-native/eslint-config": "0.79.6",
    "@react-native/metro-config": "0.79.6",
    "@react-native/typescript-config": "0.79.6",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
