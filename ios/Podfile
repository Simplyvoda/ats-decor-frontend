ENV['RCT_NEW_ARCH_ENABLED'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16'
project 'fe.xcodeproj'
prepare_react_native_project!

# Add this to fix glog
pod 'glog', :podspec => '../node_modules/react-native/third-party-podspecs/glog.podspec', :modular_headers => false

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# Forces a full git clone of the legacy Specs repo on every build (slow,
# multi-GB, and a common cause of CI worker timeouts) — commented out so
# CocoaPods falls back to its fast default CDN source instead.
# source 'https://github.com/CocoaPods/Specs.git'

$RNFirebaseAsStaticFramework = true

target 'fe' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'RNReanimated', :path => '../node_modules/react-native-reanimated'


  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['OTHER_LDFLAGS']
          config.build_settings['OTHER_LDFLAGS'] =
            config.build_settings['OTHER_LDFLAGS']
              .split
              .reject { |flag|
                flag.include?('DoubleConversion') ||
                flag.include?('RCT-Folly') ||
                flag.include?('fmt') ||
                flag.include?('glog')
              }
              .join(' ')
        end
      end
    end

    # Work around fmt's use of C++20 `consteval`, which newer Xcode/Clang
    # enforce more strictly than this bundled fmt version supports — causes
    # "call to consteval function ... is not a constant expression" in
    # format.cc during archive builds. fmt/base.h decides this via its own
    # FMT_USE_CONSTEVAL feature-detection chain and unconditionally
    # #defines FMT_CONSTEVAL from it — a compiler -D flag can't override
    # that because the header doesn't guard it with #ifndef, so patch the
    # header directly to always take the "disabled" branch.
    fmt_base_h = File.join(installer.sandbox.pod_dir('fmt').to_s, 'include/fmt/base.h')
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      needle = '#if !defined(__cpp_lib_is_constant_evaluated)'
      if content.include?(needle) && !content.include?('patched: see ios/Podfile post_install')
        patched = content.sub(needle, '#if 1 // patched: see ios/Podfile post_install — force-disable consteval')
        File.chmod(0644, fmt_base_h)
        File.write(fmt_base_h, patched)
        Pod::UI.puts 'Patched fmt base.h to force-disable FMT_USE_CONSTEVAL'.green
      end
    end

    # Patch upstream Sentry bug: SentrySDK.swift's deprecated capture(userFeedback:)
    # wrapper doesn't compile — SentrySDKInternal.capture(userFeedback:) fails to
    # resolve. Deprecated + unused by us, so disable that block after every install.
    sentry_sdk_file = File.join(installer.sandbox.pod_dir('Sentry').to_s, 'Sources/Swift/Helper/SentrySDK.swift')
    if File.exist?(sentry_sdk_file)
      content = File.read(sentry_sdk_file)
      if content.include?('SentrySDKInternal.capture(userFeedback: userFeedback)') && content.include?("    #if !SDK_V9\n")
        patched = content.sub("    #if !SDK_V9\n", "    #if false // patched: see ios/Podfile post_install\n")
        File.write(sentry_sdk_file, patched)
        Pod::UI.puts 'Patched Sentry SentrySDK.swift captureUserFeedback bug'.green
      end
    end
  end

end
