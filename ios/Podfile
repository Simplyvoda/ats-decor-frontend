ENV['RCT_NEW_ARCH_ENABLED'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16'
project 'fe.xcodeproj'
prepare_react_native_project!

# Add this to fix glog
pod 'glog', :podspec => '../node_modules/react-native/third-party-podspecs/glog.podspec', :modular_headers => false

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# Forces a full git clone of the legacy Specs repo on every build (slow,
# multi-GB, and a common cause of CI worker timeouts) — commented out so
# CocoaPods falls back to its fast default CDN source instead.
# source 'https://github.com/CocoaPods/Specs.git'

$RNFirebaseAsStaticFramework = true

use_modular_headers!

target 'fe' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'RNReanimated', :path => '../node_modules/react-native-reanimated'


  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Xcode 26's Explicit Modules build (on by default) conflicts with
        # CocoaPods' manual -fmodule-map-file overrides (see RNSentry's
        # xcconfig) and fails to build Foundation/_DarwinFoundation1 during
        # device/Archive builds — only surfaced once a Swift pod (Sentry)
        # forced full modular compilation. Disable it for Pods targets.
        config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
        config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'

        if config.build_settings['OTHER_LDFLAGS']
          config.build_settings['OTHER_LDFLAGS'] =
            config.build_settings['OTHER_LDFLAGS']
              .split
              .reject { |flag|
                flag.include?('DoubleConversion') ||
                flag.include?('RCT-Folly') ||
                flag.include?('fmt') ||
                flag.include?('glog')
              }
              .join(' ')
        end
      end
    end

    # Work around fmt's use of C++20 `consteval`, which newer Xcode/Clang
    # enforce more strictly than this bundled fmt version supports — causes
    # "call to consteval function ... is not a constant expression" in
    # format.cc during archive builds. fmt/base.h decides this via its own
    # FMT_USE_CONSTEVAL feature-detection chain and unconditionally
    # #defines FMT_CONSTEVAL from it — a compiler -D flag can't override
    # that because the header doesn't guard it with #ifndef, so patch the
    # header directly to always take the "disabled" branch.
    fmt_base_h = File.join(installer.sandbox.pod_dir('fmt').to_s, 'include/fmt/base.h')
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      needle = '#if !defined(__cpp_lib_is_constant_evaluated)'
      if content.include?(needle) && !content.include?('patched: see ios/Podfile post_install')
        patched = content.sub(needle, '#if 1 // patched: see ios/Podfile post_install — force-disable consteval')
        File.chmod(0644, fmt_base_h)
        File.write(fmt_base_h, patched)
        Pod::UI.puts 'Patched fmt base.h to force-disable FMT_USE_CONSTEVAL'.green
      end
    end

    # Work around upstream React Native bug: several ReactCommon-family
    # pods share a header_dir with a sibling pod — e.g. React-jsitooling
    # and React-RuntimeCore both use "react/runtime"; ReactCommon and
    # React-RuntimeApple both use "ReactCommon" — so without USE_FRAMEWORKS
    # (we link statically) CocoaPods puts each pair's public headers in
    # the same Headers/Public/<dir>/ folder and derives the same module
    # name for both (each podspec only gives itself a distinct module_name
    # when USE_FRAMEWORKS is set). Worse, both modulemaps in a pair also
    # declare "umbrella header", which makes Clang treat the module as
    # owning the *entire directory* it lives in — two umbrella modules
    # can't share one directory even once uniquely named ("Umbrella for
    # module ... already covers this directory"). Both problems only
    # surface once something loads every pod's modulemap in one compile —
    # Sentry's Swift interop does that via -fmodule-map-file in
    # RNSentry.xcconfig — so new pairs keep turning up one at a time as
    # more of the project gets compiled under Sentry. Fix all of them at
    # once: for every Headers/Public/<dir> shared by more than one
    # modulemap, give each module a name unique to its own pod, and
    # downgrade "umbrella header" to a plain "header" declaration. Their
    # umbrella headers already #import every header of that pod by name
    # (checked directly for the first pair hit), so directory-wide
    # inference isn't needed — each module ends up claiming only its own
    # umbrella header file, not the shared directory.
    public_headers_dir = File.join(installer.sandbox.root.to_s, 'Headers', 'Public')
    if Dir.exist?(public_headers_dir)
      Dir.children(public_headers_dir).each do |subdir|
        subdir_path = File.join(public_headers_dir, subdir)
        next unless File.directory?(subdir_path)

        modulemaps = Dir.glob(File.join(subdir_path, '*.modulemap'))
        next if modulemaps.size < 2

        modulemaps.each do |symlink_path|
          pod_name = File.basename(symlink_path, '.modulemap')
          modulemap_path = File.join(installer.sandbox.root.to_s, 'Target Support Files', pod_name, "#{pod_name}.modulemap")
          next unless File.exist?(modulemap_path)

          new_module_name = pod_name.gsub(/[^0-9A-Za-z_]/, '_')
          patched = <<~MODULEMAP
            module #{new_module_name} {
              header "#{pod_name}-umbrella.h"
              export *
            }
          MODULEMAP
          if File.read(modulemap_path) != patched
            File.write(modulemap_path, patched)
            Pod::UI.puts "Patched #{pod_name}.modulemap (shared dir #{subdir}) to non-umbrella module '#{new_module_name}'".green
          end
        end
      end
    end

    # Patch upstream Sentry bug: SentrySDK.swift's deprecated capture(userFeedback:)
    # wrapper doesn't compile — SentrySDKInternal.capture(userFeedback:) fails to
    # resolve. Deprecated + unused by us, so disable that block after every install.
    sentry_sdk_file = File.join(installer.sandbox.pod_dir('Sentry').to_s, 'Sources/Swift/Helper/SentrySDK.swift')
    if File.exist?(sentry_sdk_file)
      content = File.read(sentry_sdk_file)
      if content.include?('SentrySDKInternal.capture(userFeedback: userFeedback)') && content.include?("    #if !SDK_V9\n")
        patched = content.sub("    #if !SDK_V9\n", "    #if false // patched: see ios/Podfile post_install\n")
        File.write(sentry_sdk_file, patched)
        Pod::UI.puts 'Patched Sentry SentrySDK.swift captureUserFeedback bug'.green
      end
    end
  end

end
